@inherits LayoutComponentBase
@inject SesionActual Sesion
@inject ApiAutenticacion Autenticacion
@inject NavigationManager Navegacion

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="AlternarMenu" aria-label="Abrir o cerrar el menú" />
        <MudIcon Icon="@Icons.Material.Filled.Texture" Class="ml-2 mr-2" />
        <MudText Typo="Typo.h6">MPTextil Solutions</MudText>
        <MudSpacer />
        @if (Sesion.Usuario is { } usuario)
        {
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudStack Spacing="0" Class="d-none d-sm-flex" AlignItems="AlignItems.End">
                    <MudText Typo="Typo.body2">@usuario.Nombre</MudText>
                    <MudText Typo="Typo.caption">@usuario.Rol@(usuario.Proveedor is null ? string.Empty : $" · {usuario.Proveedor}")</MudText>
                </MudStack>
                <MudTooltip Text="Cerrar sesión">
                    <MudIconButton Icon="@Icons.Material.Filled.Logout" Color="Color.Inherit" OnClick="CerrarSesionAsync" aria-label="Cerrar sesión" />
                </MudTooltip>
            </MudStack>
        }
    </MudAppBar>
    <MudDrawer @bind-Open="_menuAbierto" ClipMode="DrawerClipMode.Always" Elevation="1" Variant="DrawerVariant.Responsive">
        <MenuNavegacion />
    </MudDrawer>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="py-6">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _menuAbierto = true;

    private void AlternarMenu() => _menuAbierto = !_menuAbierto;

    private async Task CerrarSesionAsync()
    {
        await Autenticacion.CerrarSesionAsync();
        Navegacion.NavigateTo("/iniciar-sesion");
    }
}
